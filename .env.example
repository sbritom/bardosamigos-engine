# Frontend / Supabase (somente valores publicos no VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Radio Engine (privada por padrao)
RADIO_HOST=127.0.0.1
RADIO_ENGINE_ADMIN_TOKEN=

# Radio / Icecast
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_MOUNT=/radio
ICECAST_USER=source
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=
ICECAST_RELAY_PASSWORD=
ICECAST_HOSTNAME=localhost

# Nunca coloque service_role ou credenciais reais em variaveis VITE_*.
